# RPC for single-chain demo (Sepolia example)
RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# Deployer / grantor key (TEST ONLY)
PRIVATE_KEY=0xYOUR_TEST_PRIVATE_KEY

# ERC-20 token on this chain (WETH Sepolia placeholder below)
TOKEN_ADDRESS=0xdd13E55209Fd76AfE204dBda4007C227904f0a81

# PPO fields (Authorization)
MAX_PER_PULL=1000000000000000     # 0.001 ETH (wei)
VALID_AFTER=1762353314            # unix start
VALID_BEFORE=1762439714           # unix end (e.g., +24h)
NONCE=0xa9dd5f5e04d05bf6ad269c8cd20f9a1700c9072ec35570e9e368ed33aa3fc110
